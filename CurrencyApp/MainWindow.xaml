<Window x:Class="CurrencyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurrencyApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="700" MinHeight="300" MaxHeight="400" MinWidth="700" MaxWidth="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.Row="0" Content="Select currency here:" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CurrencyComboBox" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBoxItem Content="EUR"/>
            <ComboBoxItem Content="USD"/>
            <ComboBoxItem Content="AUD"/>
            <ComboBoxItem Content="CAD"/>
            <ComboBoxItem Content="CZK"/>
            <ComboBoxItem Content="DKK"/>
            <ComboBoxItem Content="HUF"/>
            <ComboBoxItem Content="ILS"/>
            <ComboBoxItem Content="JPY"/>
            <ComboBoxItem Content="LVL"/>
            <ComboBoxItem Content="NOK"/>
            <ComboBoxItem Content="SKK"/>
            <ComboBoxItem Content="SEK"/>
            <ComboBoxItem Content="CHF"/>
            <ComboBoxItem Content="GBP"/>
            <ComboBoxItem Content="BYR"/>
            <ComboBoxItem Content="GEL"/>
            <ComboBoxItem Content="PLZ"/>
        </ComboBox>

        <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Source:" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="30" BorderThickness="1" BorderBrush="Black">
                <TextBlock x:Name="SourceTextBlock"/>
            </Border>

            <Label Grid.Row="1" Grid.Column="0" Content="Date:" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="30" BorderThickness="1" BorderBrush="Black">
                <TextBlock x:Name="DateTextBlock"/>
            </Border>

            <Label Grid.Row="2" Grid.Column="0" Content="Sale Rate:" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="30" BorderThickness="1" BorderBrush="Black">
                <TextBlock x:Name="SaleCurrencyTextBlock"/>
            </Border>

            <Label Grid.Row="3" Grid.Column="0" Content="Purchase Rate:" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Height="30" BorderThickness="1" BorderBrush="Black">
                <TextBlock x:Name="PurchaseCurrencyTextBlock"/>
            </Border>
        </Grid>

        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" x:Name="GetCurrencyButton" Content="Get currency" Background="LightGreen" HorizontalAlignment="Center" VerticalAlignment="Center" Click="GetCurrencyButton_Click"/>
    </Grid>
</Window>
